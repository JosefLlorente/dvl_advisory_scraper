# Public (browser + server). Publishable key is read-only via RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Scraper / cron only. Never expose the secret key to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Protects /api/cron/scrape. Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-string

# Optional: skip remote geocoding during a scrape run
GEOCODE_ENABLED=true

# Scraper / server only. Geocoding and Places lookups. Never expose to the client.
GOOGLE_MAPS_API_KEY=

# Scraper only. Structured advisory parse on new or changed posts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=true
